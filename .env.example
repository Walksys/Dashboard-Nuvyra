# ==============================================================================
#                      🎮 Nuvyra CONFIGURATION (.env)
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Service Listening Ports
PORT_WEB=3001
PORT_API=3003
PORT_SFTP=3004

# Database Configuration (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=27017
DB_USER=panel
DB_PASSWORD=PanelPass123!
DB_NAME=panel

# JWT Authentication Security Secret & Expiration
JWT_SECRET=nuvyra_super_secure_jwt_secret_key_2026_x892!
JWT_EXPIRES_IN=7d

# CurseForge Core API Key & Base URL for Modpacks & Plugins
CURSEFORGE_API_KEY=$2a$10$LZxbs2YslN4c0vYfFdFipuiT6vevho4SjAuSy3ppqc7SeCr3BJhsm
CURSEFORGE_BASE_URL=https://api.curseforge.com/v1

# Staff Support AI (Groq is preferred when configured; never commit the real key)
GROQ_API_KEY=
SUPPORT_AI_MODEL=mistral-saba-24b
SUPPORT_AI_TIMEOUT_MS=45000

# Optional local fallback when Groq is not configured
SUPPORT_AI_URL=http://127.0.0.1:11434

# Virtual Machine Virtualization Mode ('on', 'off' for No-KVM software emulation, or 'auto')
VM_KVM_MODE=auto
